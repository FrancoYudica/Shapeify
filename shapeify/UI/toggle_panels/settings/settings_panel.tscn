custom_minimum_size = Vector2(150, 0)
layout_mode = 2
tooltip_text = "Algorithm used to generate individuals

- RANDOM: Generates a single random indivudual
- BEST_OF_RANDOM: Generates N random individuals and adds the best to the image
- GENETIC: Uses a genetic algorithm. This involves a fixed population size, fixed generation count
                    fitness function, crossover operator, mutation operator and selection operators. This
                    is the slowest, but outputs the best results.
- HILL_CLIMB: Generates a random individual and mutates it until it reaches the maximum non 
                          improvement age limit. Note that if after mutating, the individual gets worse, it 
                          will discard the last mutation.
"
mouse_filter = 1
text = "Generator"

